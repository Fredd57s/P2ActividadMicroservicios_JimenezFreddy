// use prisma-8

model Factura {
  codigo String @unique
  fecha Date
  cod_cliente Int32
  total Double
  descuento Double
  iva Double
  total_a_pagar Double

  detalles_factura DetalleFactura[]
}

type DetalleFactura {
  codigo Int32
  cod_factura Int32
  cod_producto Int32
  cantidad Int32
  subtotal Double
}


